<Window x:Class="EyeCare.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EyeCare 设置" Width="700" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border CornerRadius="14" Background="{StaticResource Bg}"
            BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Ellipse Width="13" Height="13" Fill="{StaticResource Accent}" Margin="0,0,11,0"/>
                    <TextBlock Text="EyeCare 护眼卫士" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Width="40" Height="30" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0" Content="✕" FontSize="13" Style="{StaticResource Btn}"
                        Padding="0" BorderThickness="0" Background="Transparent"
                        Click="Close_Click"/>
            </Grid>

            <!-- 导航 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="22,2,22,10">
                <RadioButton Style="{StaticResource NavChip}" Content="🔍  护眼滤光" IsChecked="True"
                             Checked="Nav_Checked" Tag="FilterPanel"/>
                <RadioButton Style="{StaticResource NavChip}" Content="⏰  休息提醒"
                             Checked="Nav_Checked" Tag="BreakPanel"/>
                <RadioButton Style="{StaticResource NavChip}" Content="⚙  通用"
                             Checked="Nav_Checked" Tag="GeneralPanel"/>
            </StackPanel>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="22,2,22,20">
                <Grid>
                    <!-- ═══ 护眼滤光 ═══ -->
                    <StackPanel x:Name="FilterPanel">
                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="ChkFilter" Style="{StaticResource Switch}"
                                          Content="启用护眼滤光" Checked="ChkFilter_Changed" Unchecked="ChkFilter_Changed"/>
                                <TextBlock Text="通过显卡 gamma 查找表在 GPU 层面调整画面色调,截图与录屏不受影响,文字保持锐利。"
                                           Style="{StaticResource Hint}" Margin="0,10,0,0"/>

                                <TextBlock Text="色调模式" Style="{StaticResource CardTitle}" Margin="0,16,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="ModeTemp" Style="{StaticResource PresetChip}" Content="🌅 暖色色温"
                                                 Checked="Mode_Checked" Tag="temperature"/>
                                    <RadioButton x:Name="ModeGreen" Style="{StaticResource PresetChip}" Content="🌿 护眼绿"
                                                 Checked="Mode_Checked" Tag="green"/>
                                </StackPanel>

                                <StackPanel x:Name="GrnSection" Visibility="Collapsed" Margin="0,16,0,0">
                                    <Grid>
                                        <TextBlock Text="绿度" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="TxtGreenValue" Text="100 %" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Slider x:Name="SldGreen" Style="{StaticResource ModernSlider}" Margin="0,14,0,0"
                                            Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="Sld_ValueChanged"/>
                                    <TextBlock Text="100% 为经典豆沙绿（白色背景呈现柔和的暖绿色），调低则更接近原色。"
                                               Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>

                                <Border x:Name="PreviewBand" CornerRadius="10" Padding="16,12" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="预览 · EyeCare 护眼卫士" FontSize="15" FontWeight="SemiBold"
                                                   x:Name="PreviewTitle"/>
                                        <TextBlock Text="The quick brown fox jumps over the lazy dog 0123456789"
                                                   FontSize="12" Opacity="0.85" Margin="0,4,0,0" x:Name="PreviewSub"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="TempSection" Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="色温" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="TxtTempValue" Text="4800 K" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SldTemp" Style="{StaticResource ModernSlider}" Margin="0,14,0,0"
                                        Minimum="1500" Maximum="6500" TickFrequency="50" IsSnapToTickEnabled="True"
                                        ValueChanged="Sld_ValueChanged"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <RadioButton x:Name="PresetNight" Style="{StaticResource PresetChip}" Content="🌙 夜间 3400K"
                                                 Checked="Preset_Checked" Tag="3400"/>
                                    <RadioButton x:Name="PresetWarm" Style="{StaticResource PresetChip}" Content="🕯 暖光 4200K"
                                                 Checked="Preset_Checked" Tag="4200"/>
                                    <RadioButton x:Name="PresetOffice" Style="{StaticResource PresetChip}" Content="💼 办公 5000K"
                                                 Checked="Preset_Checked" Tag="5000"/>
                                    <RadioButton x:Name="PresetRead" Style="{StaticResource PresetChip}" Content="📖 阅读 5800K"
                                                 Checked="Preset_Checked" Tag="5800"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="屏幕亮度" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="TxtBrightValue" Text="100 %" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Accent}" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="SldBright" Style="{StaticResource ModernSlider}" Margin="0,14,0,0"
                                        Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="Sld_ValueChanged"/>
                                <TextBlock Text="调节范围 10%–100%。低于 50% 时自动启用遮罩加深模式,实现更深的调暗。"
                                           Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ 休息提醒 ═══ -->
                    <StackPanel x:Name="BreakPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="ChkBreak" Style="{StaticResource Switch}"
                                          Content="启用休息提醒" Checked="ChkBreak_Changed" Unchecked="ChkBreak_Changed"/>
                                <TextBlock Text="遵循 20-20-20 护眼法则:每 20 分钟,远眺 20 英尺(约 6 米)外的物体 20 秒。"
                                           Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="每隔多少分钟提醒" Style="{StaticResource CardTitle}"/>
                                        <TextBox x:Name="BoxInterval" Style="{StaticResource DarkBox}" Width="90"
                                                 HorizontalAlignment="Left" Margin="0,10,0,0"
                                                 LostFocus="Num_LostFocus" KeyDown="Num_KeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="休息时长(秒)" Style="{StaticResource CardTitle}"/>
                                        <TextBox x:Name="BoxDuration" Style="{StaticResource DarkBox}" Width="90"
                                                 HorizontalAlignment="Left" Margin="0,10,0,0"
                                                 LostFocus="Num_LostFocus" KeyDown="Num_KeyDown"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="ChkForce" Style="{StaticResource Switch}" Margin="0,0,0,14"
                                          Content="强制休息(全屏倒计时)" Checked="ChkForce_Changed" Unchecked="ChkForce_Changed"/>
                                <CheckBox x:Name="ChkAllowSkip" Style="{StaticResource Switch}" Margin="0,0,0,14"
                                          Content="允许跳过休息(强制模式下满 3 秒后可跳)" Checked="ChkAllowSkip_Changed" Unchecked="ChkAllowSkip_Changed"/>
                                <CheckBox x:Name="ChkSmartPause" Style="{StaticResource Switch}"
                                          Content="智能暂停(检测到你离开时暂停计时)" Checked="ChkSmartPause_Changed" Unchecked="ChkSmartPause_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <Button x:Name="BtnBreakNow" Content="立即休息一次" Style="{StaticResource BtnAccent}"
                                        Width="150" HorizontalAlignment="Left" Click="BreakNow_Click"/>
                                <TextBlock x:Name="TxtNextBreak" Text="距下次休息 --:--"
                                           Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ═══ 通用 ═══ -->
                    <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoStart" Style="{StaticResource Switch}"
                                          Content="开机自动启动(当前用户)" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                                <TextBlock x:Name="TxtAutoStartHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox x:Name="ChkSchedule" Style="{StaticResource Switch}" Margin="0,0,0,14"
                                          Content="定时护眼模式" Checked="ChkSchedule_Changed" Unchecked="ChkSchedule_Changed"/>
                                <TextBlock Text="在指定时间段自动切换到夜间色温(支持跨零点),其余时间使用上方手动设定。"
                                           Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="开始" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="BoxSchedStart" Style="{StaticResource DarkBox}" Width="80"
                                             LostFocus="Schedule_LostFocus" KeyDown="Num_KeyDown"/>
                                    <TextBlock Text="结束" Style="{StaticResource CardTitle}" VerticalAlignment="Center"
                                               Margin="20,0,8,0"/>
                                    <TextBox x:Name="BoxSchedEnd" Style="{StaticResource DarkBox}" Width="80"
                                             LostFocus="Schedule_LostFocus" KeyDown="Num_KeyDown"/>
                                    <TextBlock Text="夜间色温" Style="{StaticResource CardTitle}" VerticalAlignment="Center"
                                               Margin="20,0,8,0"/>
                                    <TextBox x:Name="BoxSchedTemp" Style="{StaticResource DarkBox}" Width="80"
                                             LostFocus="Schedule_LostFocus" KeyDown="Num_KeyDown"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="全局快捷键" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="切换滤光" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="BoxHotkeyToggle" Style="{StaticResource DarkBox}" Width="130"
                                             LostFocus="Hotkey_LostFocus" KeyDown="Num_KeyDown"/>
                                    <TextBlock Text="立即休息" Style="{StaticResource CardTitle}" VerticalAlignment="Center"
                                               Margin="20,0,8,0"/>
                                    <TextBox x:Name="BoxHotkeyBreak" Style="{StaticResource DarkBox}" Width="130"
                                             LostFocus="Hotkey_LostFocus" KeyDown="Num_KeyDown"/>
                                </StackPanel>
                                <TextBlock Text="格式:Ctrl+Alt+E、Ctrl+Shift+F2 等(修饰键 + 字母/数字/F1~F12),失焦后自动应用。"
                                           Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Text="关于" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                           Text="EyeCare 护眼卫士 v1.2.0 · 自用免费 · 完全本地运行,无任何联网、无任何账户。&#x0a;配置与日志保存在 %APPDATA%\EyeCare。代码完全属于你,可自由修改与分发。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
